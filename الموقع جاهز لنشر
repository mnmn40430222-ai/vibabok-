<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VibeBook - فيسبوك مصغر</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }
    body { background: #f0f2f5; color: #050505; }
    header { background: #1877f2; color: white; padding: 10px 20px; position: sticky; top: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; }
    header h1 { font-size: 24px; }
    .auth-buttons button { background: white; color: #1877f2; border: none; padding: 8px 15px; border-radius: 6px; margin-left: 10px; cursor: pointer; font-weight: bold; }
    .container { max-width: 600px; margin: 20px auto; }
    .post-box, .post { background: white; border-radius: 8px; padding: 15px; margin-bottom: 15px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .post-box textarea { width: 100%; border: none; resize: none; font-size: 16px; outline: none; }
    .post-box button { background: #1877f2; color: white; border: none; padding: 8px 20px; border-radius: 6px; margin-top: 10px; cursor: pointer; }
    .post .user { font-weight: bold; margin-bottom: 10px; }
    .post .content { margin-bottom: 10px; white-space: pre-wrap; }
    .post .link { font-size: 12px; color: #65676b; }
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; }
    .modal-content { background: white; padding: 20px; border-radius: 8px; width: 90%; max-width: 400px; }
    .modal-content input { width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ddd; border-radius: 6px; }
    .modal-content button { width: 100%; padding: 10px; background: #1877f2; color: white; border: none; border-radius: 6px; cursor: pointer; }
    .hidden { display: none; }
  </style>
</head>
<body>

<header>
  <h1>VibeBook</h1>
  <div class="auth-buttons">
    <span id="userName" class="hidden"></span>
    <button id="btnLogin">تسجيل الدخول</button>
    <button id="btnRegister">إنشاء حساب</button>
    <button id="btnFb">دخول بالفيسبوك</button>
    <button id="btnLogout" class="hidden">تسجيل الخروج</button>
  </div>
</header>

<div class="container">
  <div class="post-box">
    <textarea id="postContent" rows="3" placeholder="بماذا تفكر؟"></textarea>
    <button id="btnPost">نشر</button>
  </div>
  <div id="posts"></div>
</div>

<div class="modal" id="registerModal">
  <div class="modal-content">
    <h2>إنشاء حساب</h2>
    <input type="text" id="regName" placeholder="الاسم">
    <input type="text" id="regLastName" placeholder="اللقب">
    <input type="email" id="regEmail" placeholder="البريد الإلكتروني">
    <input type="password" id="regPass" placeholder="كلمة السر">
    <button id="btnDoRegister">تسجيل</button>
    <button onclick="closeModal()">إلغاء</button>
  </div>
</div>

<div class="modal" id="loginModal">
  <div class="modal-content">
    <h2>تسجيل الدخول</h2>
    <input type="email" id="loginEmail" placeholder="البريد الإلكتروني">
    <input type="password" id="loginPass" placeholder="كلمة السر">
    <button id="btnDoLogin">دخول</button>
    <button onclick="closeModal()">إلغاء</button>
  </div>
</div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";
  import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, signOut, onAuthStateChanged, FacebookAuthProvider, signInWithPopup, updateProfile } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";
  import { getFirestore, collection, addDoc, getDocs, query, orderBy } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBgbD-RtocVDyN7zBJAgRh4DB-8kQ4R3lE",
    authDomain: "vibebook-a95d0.firebaseapp.com",
    projectId: "vibebook-a95d0",
    storageBucket: "vibebook-a95d0.firebasestorage.app",
    messagingSenderId: "336678301596",
    appId: "1:336678301596:web:424c252efc7d0445342259",
    measurementId: "G-MWQDQQET1N"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);
  const provider = new FacebookAuthProvider();

  document.getElementById('btnRegister').onclick = () => document.getElementById('registerModal').style.display = 'flex';
  document.getElementById('btnLogin').onclick = () => document.getElementById('loginModal').style.display = 'flex';
  function closeModal(){ document.querySelectorAll('.modal').forEach(m => m.style.display='none'); }

  document.getElementById('btnDoRegister').onclick = async () => {
    const name = document.getElementById('regName').value;
    const lastName = document.getElementById('regLastName').value;
    const email = document.getElementById('regEmail').value;
    const pass = document.getElementById('regPass').value;
    const userCred = await createUserWithEmailAndPassword(auth, email, pass);
    await updateProfile(userCred.user, { displayName: name + ' + lastName });
    closeModal();
  }

  document.getElementById('btnDoLogin').onclick = async () => {
    const email = document.getElementById('loginEmail').value;
    const pass = document.getElementById('loginPass').value;
    await signInWithEmailAndPassword(auth, email, pass);
    closeModal();
  }

  document.getElementById('btnFb').onclick = async () => { await signInWithPopup(auth, provider); }
  document.getElementById('btnLogout').onclick = () => signOut(auth);

  onAuthStateChanged(auth, user => {
    if(user){
      document.getElementById('userName').innerText = user.displayName || user.email;
      document.getElementById('userName').classList.remove('hidden');
      document.getElementById('btnLogout').classList.remove('hidden');
      document.getElementById('btnLogin').classList.add('hidden');
      document.getElementById('btnRegister').classList.add('hidden');
      document.getElementById('btnFb').classList.add('hidden');
    } else {
      document.getElementById('userName').classList.add('hidden');
      document.getElementById('btnLogout').classList.add('hidden');
      document.getElementById('btnLogin').classList.remove('hidden');
      document.getElementById('btnRegister').classList.remove('hidden');
      document.getElementById('btnFb').classList.remove('hidden');
    }
  });

  document.getElementById('btnPost').onclick = async () => {
    const content = document.getElementById('postContent').value;
    if(!content) return alert('اكتب شيئا');
    const userName = auth.currentUser ? auth.currentUser.displayName : 'زائر';
    const docRef = await addDoc(collection(db, "posts"), { content: content, user: userName, createdAt: new Date() });
    document.getElementById('postContent').value = '';
    alert('تم النشر! الرابط: ' + window.location.origin + window.location.pathname + '?post=' + docRef.id);
    loadPosts();
  }

  async function loadPosts(){
    const q = query(collection(db, "posts"), orderBy("createdAt", "desc"));
    const querySnapshot = await getDocs(q);
    const postsDiv = document.getElementById('posts');
    postsDiv.innerHTML = '';
    querySnapshot.forEach((docSnap) => {
      const data = docSnap.data();
      postsDiv.innerHTML += `<div class="post"><div class="user">${data.user}</div><div class="content">${data.content}</div><div class="link">رابط المنشور: ${window.location.origin + window.location.pathname + '?post=' + docSnap.id}</div></div>`;
    });
  }
  loadPosts();

</script>
</body>
</html>
